# Example only. Do not commit Hugging Face tokens.
# Create after namespace ai-models exists (LLMInferenceService wave) or create the namespace first:
#   oc create namespace ai-models --dry-run=client -o yaml | oc apply -f -
#   oc create secret generic hf-token -n ai-models \
#     --from-literal=HF_TOKEN='hf_...'
apiVersion: v1
kind: Secret
metadata:
  name: hf-token
  namespace: ai-models
type: Opaque
stringData:
  HF_TOKEN: CHANGE_ME
