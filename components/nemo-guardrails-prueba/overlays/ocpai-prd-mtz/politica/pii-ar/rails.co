define bot informar bloqueo
  "El mensaje no puede procesarse por la política de guardrails."

define flow evaluar guardrails input
  $resultado = execute evaluar_guardrails(source="input")
  if $resultado == "blocked"
    bot informar bloqueo
    stop

define flow evaluar guardrails output
  $resultado = execute evaluar_guardrails(source="output")
  if $resultado == "blocked"
    bot informar bloqueo
    stop
