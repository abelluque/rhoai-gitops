# Example only. Do not commit production credentials.
# Create before platform-addons reconciles the Model Registry MySQL Deployment:
#   oc create namespace rhoai-model-registries --dry-run=client -o yaml | oc apply -f -
#   oc create secret generic model-registry-mysql -n rhoai-model-registries \
#     --from-literal=database-name=modelregistry \
#     --from-literal=database-user=mlmduser \
#     --from-literal=database-password='PASSWORD' \
#     --from-literal=database-root-password='ROOT_PASSWORD'
apiVersion: v1
kind: Secret
metadata:
  name: model-registry-mysql
  namespace: rhoai-model-registries
type: Opaque
stringData:
  database-name: modelregistry
  database-user: mlmduser
  database-password: CHANGE_ME
  database-root-password: CHANGE_ME
