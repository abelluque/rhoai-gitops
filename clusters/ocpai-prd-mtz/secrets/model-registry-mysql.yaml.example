# Example only. Do not commit production passwords.
# The platform-addons overlay includes Secret model-registry-mysql with CHANGE_ME
# placeholders. Replace those values in Git before the first sync, or create an
# equivalent Secret out of band and point the MySQL Deployment at existingSecret.
apiVersion: v1
kind: Secret
metadata:
  name: model-registry-mysql
  namespace: rhoai-model-registries
type: Opaque
stringData:
  database-name: modelregistry
  database-user: mlmduser
  database-password: CHANGE_ME
  database-root-password: CHANGE_ME
